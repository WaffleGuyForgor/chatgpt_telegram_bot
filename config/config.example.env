# Railway / Production Environment Variables Template
TELEGRAM_TOKEN=

# --- Groq (default provider) ---
GROQ_API_KEY=
# Multiple keys for load spreading (comma-separated):
# LLM_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# --- OpenRouter provider (optional — enables nex-agi / nvidia models) ---
# Single key:
OPENROUTER_API_KEY=
# Or multiple keys for rotation (comma-separated):
# OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # default, no need to set

# --- Dahl provider (optional — enables deepseek-ai/DeepSeek-V4-Flash-0731) ---
# Single key:
DAHL_API_KEY=
# Or multiple keys for rotation (comma-separated):
# DAHL_API_KEYS=dahl_key1,dahl_key2
# DAHL_BASE_URL=https://inference.dahl.global/v1  # default, no need to set

# --- 9Router (generic catch-all provider — just list model IDs, auto-named) ---
NINE_ROUTER_API_KEY=
# Or multiple keys for rotation (comma-separated):
# NINE_ROUTER_API_KEYS=n9_key1,n9_key2
# Comma-separated model IDs — display names are generated automatically:
# NINE_ROUTER_MODELS=openrouter/deepseek-v4.1-flash,oc/glm-5.3,claude-opus-4.8
# NINE_ROUTER_BASE_URL=https://api.9router.com/v1  # default, override if yours differs

DEFAULT_MODEL=openai/gpt-oss-20b
OWNER_ID=6274319204
MONGODB_URI=
ENABLE_MESSAGE_STREAMING=true
MAX_DIALOG_MESSAGES=30

# --- Optional: task-based model routing (disabled by default) ---
# An explicit /model choice always wins; routing only applies to users on the default model.
# ROUTING_ENABLED=false
# ROUTING_FAST_MODEL=nex-agi/nex-n2.5-mini:free
# ROUTING_DEEP_MODEL=openai/gpt-oss-120b

# --- Optional: fallback chain (comma-separated, tried in order when the primary model fails) ---
# FALLBACK_MODELS=nex-agi/nex-n2.5-pro:free,openai/gpt-oss-20b
