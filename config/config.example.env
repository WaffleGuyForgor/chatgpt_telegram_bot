# Railway / Production Environment Variables Template
TELEGRAM_TOKEN=

# --- Groq (default provider) ---
GROQ_API_KEY=
# Multiple keys for load spreading (comma-separated):
# LLM_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# --- OpenRouter provider (optional — enables nex-agi / nvidia models) ---
# Single key:
OPENROUTER_API_KEY=
# Or multiple keys for rotation (comma-separated):
# OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # default, no need to set

# --- Dahl provider (optional — enables deepseek-ai/DeepSeek-V4-Flash-0731) ---
# Single key:
DAHL_API_KEY=
# Or multiple keys for rotation (comma-separated):
# DAHL_API_KEYS=dahl_key1,dahl_key2
# DAHL_BASE_URL=https://inference.dahl.global/v1  # default, no need to set

DEFAULT_MODEL=openai/gpt-oss-20b
OWNER_ID=6274319204
MONGODB_URI=
ENABLE_MESSAGE_STREAMING=true
MAX_DIALOG_MESSAGES=30
